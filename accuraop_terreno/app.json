{
  "expo": {
    "name": "Trabs Terreno",
    "slug": "trabs-terreno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trabs.terreno"
    },
    "android": {
      "package": "com.trabs.terreno",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D3033"
      },
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#F4F6F8"
    },
    "plugins": [
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLiteCAPI": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c763fb0b-74f6-445b-8361-164c3e551a0b"
      }
    }
  }
}
